digraph GradeLifecycle {
    rankdir=LR;
    node [shape=ellipse, fontname="Helvetica", fontsize=10, style="filled", fillcolor="#F8F9FA", color="#333333"];
    edge [fontname="Helvetica", fontsize=9, color="#333333"];

    Start [shape=point, width=0.2];
    Draft [label="Draft\n(Faculty marks saved)", fillcolor="#FFF9C4"];
    Submitted [label="Submitted\n(Faculty finalized weights)", fillcolor="#BBDEFB"];
    Published [label="Published\n(Visible to Student)", fillcolor="#C8E6C9"];
    UnderReview [label="Under Review\n(Student regrade request)", fillcolor="#FFCCBC"];

    Start -> Draft [label=" Faculty inputs marks"];
    Draft -> Draft [label=" Save updates"];
    Draft -> Submitted [label=" Faculty submits grade"];
    Submitted -> Published [label=" Admin approves & publishes"];
    Published -> UnderReview [label=" Student requests review"];
    UnderReview -> Published [label=" Faculty/Admin resolves & republishes"];
}
