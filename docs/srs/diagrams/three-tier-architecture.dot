digraph ThreeTierArchitecture {
    rankdir=TB;
    node [shape=box, fontname="Helvetica", fontsize=10, style="filled", fillcolor="#F8F9FA", color="#333333"];
    edge [fontname="Helvetica", fontsize=9, color="#555555"];

    subgraph cluster_presentation {
        label="Presentation Layer";
        style="dashed";
        color="#0056B3";
        ClientUI [label="Responsive Web UI\n(Student / Faculty / Admin Dashboards)", fillcolor="#E1F5FE"];
    }

    subgraph cluster_application {
        label="Application Layer";
        style="dashed";
        color="#2E7D32";
        APIGateway [label="REST API Gateway & RBAC Middleware\n(JWT Auth, Rate Limiter)", fillcolor="#E8F5E9"];
        BusinessLogic [label="Core Services\n(Attendance Freeze Check, Rubric Engine, Grade Lifecycle)", fillcolor="#E8F5E9"];
    }

    subgraph cluster_data {
        label="Data Layer";
        style="dashed";
        color="#C62828";
        Database [label="Relational Database\n(Accounts, Schedules, Attendance, Grades)", fillcolor="#FFEBEE"];
    }

    ClientUI -> APIGateway [label="HTTPS / TLS 1.3\n(JSON Requests)"];
    APIGateway -> BusinessLogic [label="Authorized Calls"];
    BusinessLogic -> Database [label="Parameterized ORM Queries"];
}
