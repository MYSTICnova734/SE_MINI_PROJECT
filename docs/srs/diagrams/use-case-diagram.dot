// Source for docs/srs/markdown/images/use-case-diagram.png
// Regenerate (from docs/srs/diagrams/) with:
//   dot -Tpng -Gdpi=200 use-case-diagram.dot -o ../markdown/images/use-case-diagram.png
digraph usecases {
  rankdir=LR;
  nodesep=0.12; ranksep=1.0;
  splines=true;
  ordering=out;
  graph [fontname="DejaVu Sans", fontsize=13, pad=0.2];
  node  [fontname="DejaVu Sans", fontsize=11, color="#4a5568"];
  edge  [color="#4a5568", arrowhead=none];

  // ---- actors
  node [shape=box, style="filled", fillcolor="#edf2f7", margin="0.2,0.12"];
  admin   [label="«actor»\nAdministrator"];
  student [label="«actor»\nStudent"];
  faculty [label="«actor»\nFaculty"];
  anchor  [label="«actor»\nAnchor Faculty"];
  email   [label="«actor, secondary»\nEmail delivery service", style="filled,dashed", fillcolor="#f7f7f7"];

  // ---- use cases
  subgraph cluster_system {
    label="Student Record System"; labeljust=l; style="rounded"; color="#4a5568";
    node [shape=ellipse, style="filled", fillcolor="#ffffff", margin="0.12,0.06"];

    uc01 [label="UC-01\nCreate account"];
    uc02 [label="UC-02\nSet password"];
    uc03 [label="UC-03\nLog in"];
    uc06 [label="UC-06\nChange role"];
    uc05 [label="UC-05\nDeactivate or\nreactivate account"];
    uc04 [label="UC-04\nEdit student record"];
    uc07 [label="UC-07\nMark attendance"];
    uc08 [label="UC-08\nAmend attendance after\nedit window"];
    uc09 [label="UC-09\nDesignate anchor faculty"];
    uc10 [label="UC-10\nDefine rubric"];
    uc11 [label="UC-11\nEnter marks"];
    uc12 [label="UC-12\nPublish grades"];
    uc13 [label="UC-13\nAmend published mark"];
    uc14 [label="UC-14\nView published grades"];
    uc15 [label="UC-15\nRetrieve records"];

  }


  // Invisible spine: its outgoing edges fix the top-to-bottom order of the use cases.
  spine [shape=point, style=invis, width=0, height=0];
  { rank=min; spine; admin; student; }
  spine -> uc01 [style=invis]; spine -> uc04 [style=invis]; spine -> uc05 [style=invis];
  spine -> uc06 [style=invis]; spine -> uc09 [style=invis]; spine -> uc08 [style=invis];
  spine -> uc15 [style=invis]; spine -> uc03 [style=invis]; spine -> uc02 [style=invis];
  spine -> uc14 [style=invis]; spine -> uc07 [style=invis]; spine -> uc11 [style=invis];
  spine -> uc10 [style=invis]; spine -> uc12 [style=invis]; spine -> uc13 [style=invis];
  { rank=max;  faculty; anchor; email; }

  // keep the actors in a sensible vertical order
  admin -> student [style=invis];
  email -> faculty [style=invis];
  faculty -> anchor [style=invis];

  // ---- Administrator
  admin -> uc01; admin -> uc03; admin -> uc04; admin -> uc05;
  admin -> uc06; admin -> uc08; admin -> uc09; admin -> uc15;

  // ---- Student
  student -> uc02; student -> uc03; student -> uc14; student -> uc15;

  // ---- Faculty (edges drawn use case -> actor so Faculty sits on the right)
  uc02 -> faculty; uc03 -> faculty; uc07 -> faculty; uc11 -> faculty; uc15 -> faculty;

  // ---- Anchor faculty
  uc10 -> anchor; uc12 -> anchor; uc13 -> anchor;

  // ---- Secondary actor
  uc01 -> email [style=dashed];

  // ---- Generalisation: Anchor Faculty is a kind of Faculty
  anchor -> faculty [arrowhead=empty, constraint=false, label="  is a  ", fontname="DejaVu Sans", fontsize=10];
}
