digraph EntityRelationship {
    rankdir=LR;
    node [shape=rectangle, fontname="Helvetica", fontsize=10, style="filled", fillcolor="#FFFFFF", color="#333333"];
    edge [fontname="Helvetica", fontsize=9, color="#666666"];

    USER [label="USER\n---\nuser_id (PK)\nrole (Admin/Faculty/Student)\npassword_hash\nneeds_password_reset", fillcolor="#E1F5FE"];
    PROFILE [label="PROFILE\n---\nprofile_id (PK)\nuser_id (FK)\nfull_name\ncontact_details", fillcolor="#E1F5FE"];
    COURSE [label="COURSE\n---\ncourse_id (PK)\ncode, title\ncapacity_limit\nassigned_faculty_id (FK)", fillcolor="#E8F5E9"];
    RUBRIC [label="RUBRIC_COMPONENT\n---\nrubric_id (PK)\ncourse_id (FK)\ncomponent_name\nnormalized_weight", fillcolor="#E8F5E9"];
    ENROLLMENT [label="ENROLLMENT\n---\nenrollment_id (PK)\nstudent_id (FK)\ncourse_id (FK)", fillcolor="#FFF3E0"];
    SCHEDULE [label="SCHEDULE_SESSION\n---\nsession_id (PK)\ncourse_id (FK)\nscheduled_start_time\nroom_number", fillcolor="#FFF3E0"];
    ATTENDANCE [label="ATTENDANCE_RECORD\n---\nattendance_id (PK)\nsession_id (FK)\nstudent_id (FK)\nis_present (Boolean)\nmarked_at_timestamp", fillcolor="#FFEBEE"];
    GRADE [label="GRADE_RECORD\n---\ngrade_id (PK)\nenrollment_id (FK)\nrubric_id (FK)\nnumeric_score\nstate (Draft/Submitted/UnderReview/Published)", fillcolor="#FFEBEE"];

    USER -> PROFILE [label="1 : 1"];
    USER -> COURSE [label="1 : N (Faculty)"];
    USER -> ENROLLMENT [label="1 : N (Student)"];
    COURSE -> ENROLLMENT [label="1 : N"];
    COURSE -> RUBRIC [label="1 : N"];
    COURSE -> SCHEDULE [label="1 : N"];
    SCHEDULE -> ATTENDANCE [label="1 : N"];
    USER -> ATTENDANCE [label="1 : N (Student)"];
    ENROLLMENT -> GRADE [label="1 : N"];
    RUBRIC -> GRADE [label="1 : N"];
}
