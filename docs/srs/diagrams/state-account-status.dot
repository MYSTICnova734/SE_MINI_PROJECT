// Source for docs/srs/markdown/images/state-account-status.png
// Regenerate (from docs/srs/diagrams/) with:
//   dot -Tpng -Gdpi=200 state-account-status.dot -o ../markdown/images/state-account-status.png
digraph account_status {
  rankdir=TB;
  nodesep=0.5; ranksep=0.6;
  graph [fontname="DejaVu Sans", fontsize=11, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#4a5568",
         fontname="DejaVu Sans", fontsize=11, margin="0.2,0.12"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#4a5568"];

  start [shape=circle, style=filled, fillcolor="#4a5568", label="", width=0.2, height=0.2];

  active   [label="Active\nlogin allowed once the user\nhas set a password", fillcolor="#e4f4e8"];
  inactive [label="Inactive\nlogin blocked, sessions invalidated\nrecord retained and viewable\nby Administrators", fillcolor="#f7f7f7"];

  start    -> active   [label="Administrator\ncreates the account"];
  active   -> inactive [label="Administrator deactivates\n(confirmation required)", constraint=true];
  inactive -> active   [label="Administrator reactivates", constraint=false];
}
