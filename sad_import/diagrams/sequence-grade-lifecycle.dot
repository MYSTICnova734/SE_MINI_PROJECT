digraph GradeLifecycleSequence {
    graph [dpi=300, rankdir=TB, nodesep=0.5, ranksep=0.4, margin=0.2, bgcolor=transparent];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9, arrowsize=0.8];

    // Participants
    subgraph cluster_participants {
        style=invis;
        { rank=same;
            P_Client  [label="User Client\n(Faculty / Admin / Student)", shape=box, style="filled,rounded", fillcolor="#E1F5FE", color="#0288D1", width=2.0];
            P_Gateway [label="API Gateway\n(Auth & RBAC)", shape=box, style="filled,rounded", fillcolor="#E8F5E9", color="#388E3C", width=2.0];
            P_Engine  [label="Grade Lifecycle Engine\n(Business Rules)", shape=box, style="filled,rounded", fillcolor="#FFF3E0", color="#F57C00", width=2.0];
            P_DB      [label="Database\n(Relational Store)", shape=cylinder, style=filled, fillcolor="#FFEBEE", color="#D32F2F", width=2.0];
        }
    }

    // Sequence steps
    node [shape=point, width=0, height=0, style=invis];

    // Lifelines
    C1; C2; C3; C4; C5; C6; C7; C8;
    P_Client -> C1 -> C2 -> C3 -> C4 -> C5 -> C6 -> C7 -> C8 [style=dashed, color="#888888", arrowhead=none];

    G1; G2; G3; G4; G5; G6; G7; G8;
    P_Gateway -> G1 -> G2 -> G3 -> G4 -> G5 -> G6 -> G7 -> G8 [style=dashed, color="#888888", arrowhead=none];

    E1; E2; E3; E4; E5; E6; E7; E8;
    P_Engine -> E1 -> E2 -> E3 -> E4 -> E5 -> E6 -> E7 -> E8 [style=dashed, color="#888888", arrowhead=none];

    D1; D2; D3; D4; D5; D6; D7; D8;
    P_DB -> D1 -> D2 -> D3 -> D4 -> D5 -> D6 -> D7 -> D8 [style=dashed, color="#888888", arrowhead=none];

    // Align ranks
    { rank=same; C1; G1; }
    { rank=same; G2; E2; }
    { rank=same; E3; D3; }
    { rank=same; C4; G4; }
    { rank=same; G5; E5; }
    { rank=same; E6; D6; }
    { rank=same; C7; G7; }
    { rank=same; G8; E8; }

    // Messages
    C1 -> G1 [label=" 1. POST /api/v1/grades (mark_entry, state=Draft) ", color="#0288D1", fontcolor="#0288D1"];
    G2 -> E2 [label=" 2. Validate JWT & RBAC (Faculty Role) ", color="#388E3C", fontcolor="#388E3C"];
    E3 -> D3 [label=" 3. Save Draft Score Records ", color="#F57C00", fontcolor="#F57C00"];
    
    C4 -> G4 [label=" 4. POST /grades/submit (Faculty Action) ", color="#0288D1", fontcolor="#0288D1"];
    G5 -> E5 [label=" 5. Validate Role -> Auto-Normalize Rubric Weights ", color="#388E3C", fontcolor="#388E3C"];
    E6 -> D6 [label=" 6. Transition state -> 'Submitted' ", color="#F57C00", fontcolor="#F57C00"];

    C7 -> G7 [label=" 7. POST /grades/publish (Admin Action) / dispute (Student) ", color="#0288D1", fontcolor="#0288D1"];
    G8 -> E8 [label=" 8. Update State -> 'Published' or 'Under Review' ", color="#D32F2F", fontcolor="#D32F2F"];
}
